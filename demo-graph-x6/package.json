{
  "name": "@alilc/lowcode-demo-graph-x6",
  "version": "1.0.28",
  "description": "Low-Code Engine 低代码搭建引擎 Demo 项目 - X6 画布",
  "repository": "git@github.com:alibaba/lowcode-demo.git",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('public/react-simulator-renderer.js',{force:true});fs.rmSync('public/react-simulator-renderer.css',{force:true})\"",
    "build:simulator": "vite build --config vite.config.simulator.ts",
    "predev": "pnpm run build:simulator",
    "prebuild": "pnpm run build:simulator",
    "prepublishOnly": "pnpm run build",
    "pub": "node ./scripts/watchdog.cjs && npm pub"
  },
  "dependencies": {
    "@alifd/next": "^1.27.34",
    "@alifd/theme-lowcode-light": "^0.2.1",
    "@alilc/lce-graph-core": "workspace:*",
    "@alilc/lce-graph-materials-pane": "workspace:*",
    "@alilc/lce-graph-tools": "workspace:*",
    "@alilc/lce-graph-x6-designer": "workspace:*",
    "@alilc/lowcode-engine": "workspace:*",
    "@alilc/lowcode-plugin-inject": "workspace:*",
    "@alilc/lowcode-react-simulator-renderer": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "@antv/x6": "^1.35.1",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "path-browserify": "^1.0.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
