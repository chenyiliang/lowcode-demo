{
  "name": "@alilc/lowcode-demo-general",
  "version": "1.0.28",
  "description": "Low-Code Engine 低代码搭建引擎 Demo 项目 - 综合场景",
  "repository": "git@github.com:alibaba/lowcode-demo.git",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run copy:worker && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('public/react-simulator-renderer.js',{force:true});fs.rmSync('public/react-simulator-renderer.css',{force:true})\"",
    "build:simulator": "vite build --config vite.config.simulator.ts",
    "predev": "pnpm run build:simulator",
    "prebuild": "pnpm run build:simulator",
    "prepublishOnly": "pnpm run build",
    "pub": "node ./scripts/watchdog.cjs && npm pub",
    "copy:worker": "node ../scripts/copy-codegen-worker.mjs"
  },
  "dependencies": {
    "@alifd/next": "^1.27.34",
    "@alifd/theme-lowcode-light": "^0.2.1",
    "@alilc/lowcode-datasource-fetch-handler": "workspace:*",
    "@alilc/lowcode-engine": "workspace:*",
    "@alilc/lowcode-engine-ext": "workspace:*",
    "@alilc/lowcode-plugin-code-editor": "workspace:*",
    "@alilc/lowcode-plugin-code-generator": "workspace:*",
    "@alilc/lowcode-plugin-components-pane": "workspace:*",
    "@alilc/lowcode-plugin-datasource-pane": "workspace:*",
    "@alilc/lowcode-plugin-inject": "workspace:*",
    "@alilc/lowcode-plugin-manual": "workspace:*",
    "@alilc/lowcode-plugin-schema": "workspace:*",
    "@alilc/lowcode-plugin-set-ref-prop": "workspace:*",
    "@alilc/lowcode-plugin-simulator-select": "workspace:*",
    "@alilc/lowcode-plugin-undo-redo": "workspace:*",
    "@alilc/lowcode-plugin-zh-en": "workspace:*",
    "@alilc/lowcode-react-renderer": "workspace:*",
    "@alilc/lowcode-react-simulator-renderer": "workspace:*",
    "@alilc/lowcode-setter-behavior": "^1.0.0",
    "@alilc/lowcode-setter-title": "^1.0.2",
    "@alilc/lowcode-types": "workspace:*",
    "@alilc/lowcode-utils": "workspace:*",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@alilc/lowcode-code-generator": "workspace:*",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "path-browserify": "^1.0.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
